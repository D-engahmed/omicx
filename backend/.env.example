# Application environment
APP_ENV=development

# HTTP server
# HTTP server
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logging
LOG_LEVEL=debug

# PostgreSQL
POSTGRES_DB=omicx
POSTGRES_USER=omicx
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5433

# Go database connection
DATABASE_URL=postgres://omicx:local_dev_only_change_me@127.0.0.1:5433/omicx?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_CONNECT_TIMEOUT=5s